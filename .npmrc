# Installing a package must not run its code: no lifecycle scripts, ours
# included (so `npm run prepare` is a manual step once after cloning).
ignore-scripts=true
# New dependencies are saved at an exact version; updates are deliberate.
save-exact=true
# Never resolve to a version published in the last 7 days. Most hijacked
# releases are caught and pulled inside that window. Needs npm 11.10 or later
# (older npm ignores the key); `npm ci` installs the lockfile and never asks.
min-release-age=7

{
  "private": true,
  "name": "frisp",
  "version": "2.0.0",
  "type": "module",
  "homepage": "https://frisp.app",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#client/*": "./src/client/*",
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*",
    "#sw/*": "./src/sw/*",
    "#worker-shared/*": "./src/worker-shared/*",
    "#codecs/*": "./codecs/*",
    "#app-generated/*": "./.svelte-kit/app-generated/*"
  },
  "scripts": {
    "audit:static-output": "node scripts/audit-static-output.mjs",
    "build": "npm run sync && vite build",
    "typecheck": "npm run sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.service-worker.json && tsc -p tests/tsconfig.json",
    "typecheck:fast": "npm run sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --incremental",
    "check": "npm run typecheck && vite build && npm run audit:static-output",
    "audit": "node scripts/audit-deps.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev": "vite dev",
    "format": "prettier --write \"**/*.{js,css,json,ts,tsx,svelte}\"",
    "format:check": "prettier --check \"**/*.{js,css,json,ts,tsx,svelte}\"",
    "prepare": "(svelte-kit sync || echo '') && node scripts/install-git-hooks.mjs",
    "preview": "vite preview",
    "sync": "node scripts/patch-codec-wrappers.mjs",
    "social-card": "node scripts/generate-social-card.mjs",
    "pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "test": "npm run check && npm run test:unit && PLAYWRIGHT_SKIP_BUILD=1 npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "bench": "playwright test --config benchmarks/playwright.config.ts",
    "bench:compare": "node benchmarks/compare.mjs",
    "bench:svg": "node benchmarks/svg/run-frisp.mjs",
    "bench:svg:compare": "node benchmarks/svg/compare.mjs",
    "typecheck:tests": "tsc -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.13.2",
    "client-zip": "^2.5.0",
    "comlink": "^4.4.2",
    "lint-staged": "^17.0.8",
    "pointer-tracker": "^2.5.3",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "simple-git-hooks": "^2.13.1",
    "svelte": "5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "^4.1.9",
    "wasm-feature-detect": "^1.8.0"
  },
  "overrides": {
    "cookie": "1.1.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,css,json,ts,tsx,svelte}": "prettier --write"
  },
  "prettier": {
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pixelmatch": "^7.2.0",
    "svgo": "^4.1.0"
  }
}

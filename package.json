{
  "private": true,
  "name": "frisp",
  "version": "2.0.0",
  "type": "module",
  "homepage": "https://frisp.app",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#client/*": "./src/client/*",
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*",
    "#sw/*": "./src/sw/*",
    "#worker-shared/*": "./src/worker-shared/*",
    "#codecs/*": "./codecs/*",
    "#app-generated/*": "./.svelte-kit/app-generated/*"
  },
  "scripts": {
    "audit:static-output": "node scripts/audit-static-output.mjs",
    "build": "pnpm run sync && vite build",
    "typecheck": "pnpm run sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.service-worker.json && tsc -p tests/tsconfig.json",
    "typecheck:fast": "pnpm run sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --incremental",
    "check": "pnpm run verify:codecs && pnpm run typecheck && vite build && pnpm run audit:static-output",
    "audit": "node scripts/audit-deps.mjs",
    "verify:codecs": "node scripts/verify-codec-artifacts.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev": "vite dev",
    "format": "prettier --write \"**/*.{js,css,json,ts,tsx,svelte}\"",
    "format:check": "prettier --check \"**/*.{js,css,json,ts,tsx,svelte}\"",
    "prepare": "(svelte-kit sync || echo '') && node scripts/install-git-hooks.mjs",
    "preview": "vite preview",
    "sync": "node scripts/patch-codec-wrappers.mjs",
    "social-card": "node scripts/generate-social-card.mjs",
    "stats": "node scripts/stats.mjs",
    "pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "test": "pnpm run check && pnpm run test:unit && PLAYWRIGHT_SKIP_BUILD=1 pnpm run test:e2e",
    "test:unit": "svelte-kit sync && vitest run",
    "test:e2e": "playwright test",
    "bench": "playwright test --config benchmarks/playwright.config.ts",
    "bench:compare": "node benchmarks/compare.mjs",
    "bench:svg": "node benchmarks/svg/run-frisp.mjs",
    "bench:svg:compare": "node benchmarks/svg/compare.mjs",
    "typecheck:tests": "svelte-kit sync && tsc -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.13.2",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "prettier": {
    "endOfLine": "lf",
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "client-zip": "2.5.1",
    "comlink": "4.4.2",
    "fflate": "0.8.3",
    "svgo": "4.1.0"
  },
  "packageManager": "pnpm@12.21.0"
}
